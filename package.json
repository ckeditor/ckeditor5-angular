{
  "__IMPORTANT__": "This file won't be published. See `src/ckeditor/package.json`, which will be published on NPM.",
  "name": "@ckeditor/ckeditor5-angular",
  "version": "12.0.0",
  "private": true,
  "description": "Official Angular component for CKEditor 5 – the best browser-based rich text editor.",
  "scripts": {
    "nice": "ckeditor5-dev-changelog-create-entry",
    "postinstall": "node ./scripts/postinstall.js",
    "start": "node ./scripts/start.mjs",
    "build": "ng build --configuration production",
    "test": "vitest run --project zone --project zoneless",
    "test:dev": "vitest --project zone --project zoneless",
    "test:e2e": "playwright test",
    "test:scripts": "vitest --config ./scripts-tests/vitest.config.mjs --run",
    "coverage": "vitest run --project zone --project zoneless --coverage",
    "lint": "eslint",
    "build-package": "ng-packagr -p src/ckeditor/ng-package.json",
    "release:prepare-changelog": "node scripts/preparechangelog.mjs",
    "release:prepare-packages": "node scripts/preparepackages.mjs",
    "release:publish-packages": "node scripts/publishpackages.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@ckeditor/ckeditor5-integrations-common": "^3.2.0",
    "rxjs": "^6.5.5",
    "tslib": "^2.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.8.1",
    "@analogjs/vitest-angular": "^2.8.1",
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "@angular/language-service": "^21.2.25",
    "@ckeditor/ckeditor5-dev-bump-year": "^62.5.0",
    "@ckeditor/ckeditor5-dev-changelog": "^62.5.0",
    "@ckeditor/ckeditor5-dev-ci": "^62.5.0",
    "@ckeditor/ckeditor5-dev-release-tools": "^62.5.0",
    "@ckeditor/ckeditor5-dev-utils": "^62.5.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "ckeditor5": "^49.0.0",
    "ckeditor5-premium-features": "^49.0.0",
    "eslint": "^10.0.0",
    "eslint-config-ckeditor5": "^19.0.0",
    "eslint-plugin-ckeditor5-rules": "^19.0.0",
    "fs-extra": "^10.0.1",
    "globals": "^16.1.0",
    "husky": "^8.0.2",
    "lint-staged": "^10.4.0",
    "minimist": "^1.2.8",
    "ng-packagr": "^21.2.7",
    "playwright": "^1.63.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.32.0",
    "upath": "^2.0.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=26.10.0",
    "pnpm": "^12.8.2",
    "yarn": "\n\n┌─────────────────────────┐\n│  Hey, we use pnpm now!  │\n└─────────────────────────┘\n\n"
  },
  "author": "CKSource (http://cksource.com/)",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://ckeditor.com",
  "bugs": "https://github.com/ckeditor/ckeditor5-angular/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/ckeditor/ckeditor5-angular.git"
  },
  "lint-staged": {
    "**/*": [
      "eslint --quiet"
    ]
  }
